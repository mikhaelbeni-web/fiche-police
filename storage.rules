rules_version = '2';
// Règles Firebase Storage (Firebase Console > Storage > Règles).
// Mêmes conditions que firestore.rules. Voir docs/securite-firestore.md.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == "reception-gate";
    }
  }
}
